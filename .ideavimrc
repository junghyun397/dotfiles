" set tai to find action id
" SYSTEM
set belloff=all
set shell=zsh
set ul=10000

" SEARCH
set ic
set is
set hls

" NAVIGATION
set scrolloff=5
set rnu
set nu

nnoremap <C-n> :NERDTree<CR>
set NERDTree

" APPEARANCE
set showmode

" KEYMAP
let mapleader = "\<space>"
nnoremap <space> <nop>

noremap <leader>y "+y
nnoremap <leader>p "+p
nnoremap <leader>P "+P

noremap <leader>4 $

" IDEA NAVIGATION
map <leader>h :action Back<cr>
map <leader>l :action Forward<cr>
map <leader>e :action GotoFile<cr>
map <leader><space> :action SearchEverywhere<cr>

map ge :action GotoNextError<cr>
map gE :action GotoPreviousError<cr>
map gj :action GotoDeclaration<cr> 

" IDEA EXECUTION
map <leader>r :action Run<cr>
map <leader>s :action Stop<cr>
map <leader>f :action ShowHoverInfo<cr>

" IDEA DEBUG
map <leader>dd :action Debug<cr>
map <leader>dm :action ToggleLineBreakpoint<cr>

" IDEA REFACTOR
set idearefactormode=visual
set ideajoin

" PLUGINS
set surround

" HANDLER
" GOTO
sethandler <C-B> a:ide
sethandler <C-U> a:vim
sethandler <C-D> a:vim
" RECENT FILES
sethandler <C-E> a:ide
sethandler <C-F> a:vim
sethandler <C-G> a:vim
sethandler <C-H> a:vim
sethandler <C-I> a:vim
sethandler <C-J> a:vim
" COMMIT
sethandler <C-K> a:ide
sethandler <C-L> a:vim
sethandler <C-M> a:vim
sethandler <C-N> a:vim
sethandler <C-O> a:vim
sethandler <C-P> a:vim
" KILL
sethandler <C-Q> a:ide
sethandler <C-R> a:vim
sethandler <C-S> a:vim
sethandler <C-T> a:vim
sethandler <C-U> a:vim
sethandler <C-V> a:vim
" EXTEND SELECTION => SELECT MODE
sethandler <C-W> v:ide
sethandler <C-X> a:vim
sethandler <C-Y> a:vim
sethandler <C-[> a:vim
sethandler <C-\> a:vim
sethandler <C-]> a:vim
